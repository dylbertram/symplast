# Local signing template (no real values).
#
# Copy to the repository root as a git-ignored `release.env`, then lock it down:
#   cp docs/maintainers/release.env.example release.env
#   chmod 600 release.env
#   set -a; . release.env; set +a   # load before packaging
#
# `release.env` is git-ignored — never commit it or paste its values anywhere.
# This drives LOCAL packaging (scripts/package-release.sh). The GitHub release
# workflow reads its own copies from the `release` environment. See signing.md.

# ---- Local packaging --------------------------------------------------------
export VERSION="0.1.0"

# Developer ID Application identity NAME (from `security find-identity -v -p codesigning`).
# Use the quoted common name WITHOUT the quotes, and NOT the SHA-1 hash:
#   Developer ID Application: Example Name (<TEAMID>)
export CODESIGN_IDENTITY=""

# Notarization via the Apple ID flow. APPLE_APP_PASSWORD is an app-specific
# password from account.apple.com — never your Apple account login password.
export APPLE_ID=""
export APPLE_TEAM_ID=""          # <TEAMID>
export APPLE_APP_PASSWORD=""     # xxxx-xxxx-xxxx-xxxx

# ---- CI-only secrets (do NOT put these here) --------------------------------
# The release workflow imports these into a disposable runner keychain. Locally
# the certificate and key are already in your keychain, so they are not needed:
#   MACOS_CERTIFICATE       base64 of the exported .p12 (certificate + private key)
#   MACOS_CERTIFICATE_PWD   password protecting that .p12
#   KEYCHAIN_PWD            separate random password for the runner keychain
# Set them with: gh secret set NAME --repo <owner>/symplast --env release

# ---- Website (Cloudflare Pages) — CI, not local packaging -------------------
# Stored in the GitHub `website` environment. Uncomment only if you also run
# wrangler locally against the same project.
# export CLOUDFLARE_ACCOUNT_ID=""
# export CLOUDFLARE_API_TOKEN=""
